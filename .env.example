# ==========================================================================
# PokeMyth Online — variáveis de ambiente (exemplo)
# Copie para .env.local e preencha. NÃO commitar chaves reais.
# ==========================================================================

# Site
NEXT_PUBLIC_SITE_URL=https://pokemyth.online

# --------------------------------------------------------------------------
# Discord
# --------------------------------------------------------------------------
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/cEDvqWQzXp

# --------------------------------------------------------------------------
# Waitlist de Players Fundadores → Google Sheets
# Passo a passo completo: scripts/apps-script/README.md
# --------------------------------------------------------------------------
# URL do Web App do Apps Script (termina em /exec)
WAITLIST_SHEETS_URL=
# Segredo gerado pela função setup() do Apps Script
WAITLIST_SHARED_SECRET=

# --------------------------------------------------------------------------
# Pagamentos (Market RMT — PIX e cartão)
# Contrato do gateway: lib/payments/ · Rotas: app/api/payments/
# Taxas da plataforma: lib/config/payments.ts
# --------------------------------------------------------------------------
# Gateway ativo: mercadopago | stripe | asaas | (vazio = desligado)
PAYMENT_PROVIDER=
# Chave secreta do servidor (Access Token / Secret Key)
PAYMENT_PROVIDER_KEY=
# Chave pública, usada no navegador para tokenizar o cartão
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=
# Segredo de validação da assinatura dos webhooks
PAYMENT_WEBHOOK_SECRET=

# Webhook a cadastrar no painel do gateway:
#   https://SEU_DOMINIO/api/payments/webhook/<PAYMENT_PROVIDER>

# --------------------------------------------------------------------------
# Supabase (Auth / Database / Storage) — TODO: preencher ao integrar
# Necessário para reativar featureFlags.accountsEnabled
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# API do servidor do jogo — TODO
# --------------------------------------------------------------------------
GAME_API_URL=
GAME_API_KEY=
